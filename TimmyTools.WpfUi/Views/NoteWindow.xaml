<Window x:Class="TimmyTools.WpfUi.Views.NoteWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:vm="clr-namespace:TimmyTools.WpfUi.ViewModels"
        xmlns:controls="clr-namespace:TimmyTools.WpfUi.Controls"
        mc:Ignorable="d"

        BorderThickness="1"
        Icon="/Images/icon.ico"
        MinHeight="75"
        MinWidth="150"
        ResizeMode="CanResize"
        WindowStyle="None"

        FocusManager.FocusedElement="{Binding ElementName=NoteTextBox}"

        Left="{Binding Note.X}"
        Top="{Binding Note.Y}"
        Width="{Binding Note.Width, Mode=TwoWay}"
        Height="{Binding Note.Height, Mode=TwoWay}"
        AllowsTransparency="{Binding Note.TransparencyEnabled}"
        ShowInTaskbar="{Binding Note.ShowInTaskbar}"
        Background="Transparent"
        BorderBrush="{Binding Note.BorderBrush}"
        d:DataContext="{d:DesignInstance Type=vm:NoteViewModel}"
        d:Height="300"
        d:Width="300"
        d:Background="#fffcdd"
        d:BorderBrush="#feea00">

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome
            CaptionHeight="0"
            UseAeroCaptionButtons="False"
            GlassFrameThickness="0"
            CornerRadius="0"
            ResizeBorderThickness="5"/>
    </shell:WindowChrome.WindowChrome>

    <Window.Resources>
        <!-- Title Bar Buttons -->
        <Style x:Key="TitleBarButtonStyle" TargetType="Control">
            <Setter Property="Width" Value="20"/>
            <Setter Property="Height" Value="20"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Opacity" Value="0.6"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Opacity" Value="1.0"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Show/Hide Title Bar -->
        <Storyboard x:Key="HideTitleBarAnimation">
            <DoubleAnimation Storyboard.TargetName="TitleBarGrid"
                             Storyboard.TargetProperty="Height" 
                             To="0" Duration="0:0:0.2" />
        </Storyboard>
        <Storyboard x:Key="ShowTitleBarAnimation">
            <DoubleAnimation Storyboard.TargetName="TitleBarGrid"
                             Storyboard.TargetProperty="Height" 
                             To="40" Duration="0:0:0.2" />
        </Storyboard>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Title Bar -->
        <Grid Name="TitleBarGrid"
              Grid.Column="0"
              Grid.Row="0"
              Height="40"
              Background="{Binding Note.TitleGridBackground}"
              d:Background="#fef7b1">

            <!-- Left Side Buttons -->
            <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Center"
                        Margin="10,0,0,0">

                <!-- New Note Button -->
                <Button Name="NewButton"
                        Margin="0"
                        ToolTip="New Note"
                        Style="{StaticResource TitleBarButtonStyle}">
                    <Button.Template>
                        <ControlTemplate>
                            <Canvas>
                                <Rectangle Width="20" Height="20" Fill="Transparent" />
                                <Path Data="M 10,2 v 16 M 2,10 h 16"
                                      Stroke="{Binding Note.TitleGridButtonForeground}"
                                      StrokeThickness="3"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                      d:Stroke="#464646">
                                </Path>
                            </Canvas>
                        </ControlTemplate>
                    </Button.Template>
                </Button>

                <!-- Atomic Clock Button -->
                <Button Name="AtomicClockButton"
                        Margin="6,0,0,0"
                        ToolTip="Atomic Clock"
                        Style="{StaticResource TitleBarButtonStyle}">
                    <Button.Template>
                        <ControlTemplate>
                            <Canvas>
                                <Rectangle Width="20" Height="20" Fill="Transparent" />
                                <Ellipse Width="16" Height="16" Canvas.Left="2" Canvas.Top="2"
                                         Stroke="{Binding Note.TitleGridButtonForeground}"
                                         StrokeThickness="2"
                                         d:Stroke="#464646"/>
                                <Path Data="M 10,5 V 10 H 14"
                                      Stroke="{Binding Note.TitleGridButtonForeground}"
                                      StrokeThickness="2"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                      d:Stroke="#464646"/>
                            </Canvas>
                        </ControlTemplate>
                    </Button.Template>
                </Button>

                <!-- Break Timer Button -->
                <Button Name="BreakTimerButton"
                        Margin="6,0,0,0"
                        ToolTip="Break Timer"
                        Style="{StaticResource TitleBarButtonStyle}">
                    <Button.Template>
                        <ControlTemplate>
                            <Canvas>
                                <Rectangle Width="20" Height="20" Fill="Transparent" />
                                <!-- Cup body (U shape) -->
                                <Path Data="M 3,7 V 17 H 12 V 7"
                                      Stroke="{Binding Note.TitleGridButtonForeground}"
                                      StrokeThickness="2"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                      StrokeLineJoin="Round"
                                      d:Stroke="#464646"/>
                                <!-- Handle -->
                                <Path Data="M 12,9 C 16,9 16,14 12,14"
                                      Stroke="{Binding Note.TitleGridButtonForeground}"
                                      StrokeThickness="2"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                      Fill="Transparent"
                                      d:Stroke="#464646"/>
                                <!-- Steam wisps -->
                                <Path Data="M 6,2 Q 7,4 6,5 M 9,2 Q 10,4 9,5"
                                      Stroke="{Binding Note.TitleGridButtonForeground}"
                                      StrokeThickness="1.5"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                      d:Stroke="#464646"/>
                            </Canvas>
                        </ControlTemplate>
                    </Button.Template>
                </Button>

                <!-- Clipboard Button -->
                <Button Name="ClipboardButton"
                        Margin="6,0,0,0"
                        ToolTip="Clipboard"
                        Style="{StaticResource TitleBarButtonStyle}">
                    <Button.Template>
                        <ControlTemplate>
                            <Canvas>
                                <Rectangle Width="20" Height="20" Fill="Transparent" />
                                <!-- Board body -->
                                <Path Data="M 4,4 H 16 V 18 H 4 Z"
                                      Stroke="{Binding Note.TitleGridButtonForeground}"
                                      StrokeThickness="2"
                                      StrokeLineJoin="Round"
                                      Fill="Transparent"
                                      d:Stroke="#464646"/>
                                <!-- Clip tab at top -->
                                <Path Data="M 8,4 V 2.5 H 12 V 4"
                                      Stroke="{Binding Note.TitleGridButtonForeground}"
                                      StrokeThickness="2"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                      StrokeLineJoin="Round"
                                      d:Stroke="#464646"/>
                                <!-- Two content lines -->
                                <Path Data="M 7,9 H 13 M 7,13 H 13"
                                      Stroke="{Binding Note.TitleGridButtonForeground}"
                                      StrokeThickness="1.5"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                      d:Stroke="#464646"/>
                            </Canvas>
                        </ControlTemplate>
                    </Button.Template>
                </Button>

            </StackPanel>

            <!-- Title Display -->
            <TextBlock HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       Margin="88,0,56,0"
                       Text="{Binding Note.Title}"
                       FontFamily="Bahnschrift"
                       FontSize="17"
                       Foreground="{Binding Note.TitleGridButtonForeground}"
                       TextTrimming="CharacterEllipsis"
                       MaxWidth="160"
                       d:Text="My Note Title"
                       d:Foreground="#464646">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Note.Title}" Value="{x:Null}">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Note.Title}" Value="">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>

            <!-- Right Side Buttons -->
            <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        Margin="0,0,10,0">

                <!-- Minimize Button -->
                <Button Name="MinimizeButton"
                        Margin="0"
                        ToolTip="Minimize"
                        Style="{StaticResource TitleBarButtonStyle}">
                    <Button.Template>
                        <ControlTemplate>
                            <Canvas>
                                <Rectangle Width="20" Height="20" Fill="Transparent" />
                                <Path Data="M 3,15 h 14"
                                      Stroke="{Binding Note.TitleGridButtonForeground}"
                                      StrokeThickness="3"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                      d:Stroke="#464646">
                                </Path>
                            </Canvas>
                        </ControlTemplate>
                    </Button.Template>
                </Button>

                <!-- Close Button -->
                <Button Name="CloseButton"
                        Margin="6,0,0,0"
                        ToolTip="Close"
                        Style="{StaticResource TitleBarButtonStyle}">
                    <Button.Template>
                        <ControlTemplate>
                            <Canvas>
                                <Rectangle Width="20" Height="20" Fill="Transparent" />
                                <Path Data="M 3,3 L 17,17 M 3,17 L 17,3"
                                      Stroke="{Binding Note.TitleGridButtonForeground}"
                                      StrokeThickness="3"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                      d:Stroke="#464646">
                                </Path>
                            </Canvas>
                        </ControlTemplate>
                    </Button.Template>
                </Button>

            </StackPanel>

            <!-- Context Menu -->
            <Grid.ContextMenu>
                <ContextMenu Name="TitleBarContextMenu">
                    <MenuItem Header="Set Title" Click="SetTitleMenuItem_Click" />
                    <Separator />
                    <MenuItem Header="Save" Click="SaveMenuItem_Click" />
                    <Separator />
                    <MenuItem Header="Reset size" Click="ResetMenuItem_Click" />
                    <Separator />
                    <!-- Theme options are added dynamically in code behind -->
                    <Separator Name="ThemeMenuSeparator" />
                    <MenuItem Header="Settings" Click="SettingsMenuItem_Click" />
                </ContextMenu>
            </Grid.ContextMenu>

        </Grid>

        <!-- Text Box -->
        <Grid Name="NoteBodyGrid" Grid.Column="0" Grid.Row="1" Background="{Binding Note.Background}">
            <controls:NoteTextBoxControl BorderThickness="0"
                                         Background="Transparent"
                                         Foreground="{Binding Note.ContentTextBoxForeground}"
                                         CaretThickness="{Binding EditorSettings.CaretThickness}"
                                         CaretColour="{Binding EditorSettings.CaretColour}"
                                         FontSize="18"
                                         x:Name="NoteTextBox"
                                         Padding="5,5,5,5"
                                         RtfContent="{Binding Note.Content, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"

                                         SpellCheck.IsEnabled="{Binding EditorSettings.CheckSpelling}"
                                         NewLineAtEnd="{Binding EditorSettings.NewLineAtEnd}"
                                         KeepNewLineAtEndVisible="{Binding EditorSettings.KeepNewLineVisible}"
                                         WrapText="{Binding EditorSettings.WrapText}"

                                         StandardFontFamily="{Binding EditorSettings.StandardFontFamily}"
                                         MonoFontFamily="{Binding EditorSettings.MonoFontFamily}"
                                         UseMonoFont="{Binding EditorSettings.UseMonoFont}"

                                         AutoIndent="{Binding EditorSettings.AutoIndent}"
                                         TabSpaces="{Binding EditorSettings.UseSpacesForTab}"
                                         ConvertIndentation="{Binding EditorSettings.ConvertIndentationOnPaste}"
                                         TabWidth="{Binding EditorSettings.TabSpacesWidth}"

                                         CopyAction="{Binding EditorSettings.CopyAction}"
                                         TrimTextOnCopy="{Binding EditorSettings.TrimTextOnCopy}"
                                         CopyAltAction="{Binding EditorSettings.CopyAltAction}"
                                         TrimTextOnAltCopy="{Binding EditorSettings.TrimTextOnAltCopy}"
                                         CopyFallbackAction="{Binding EditorSettings.CopyFallbackAction}"
                                         TrimTextOnFallbackCopy="{Binding EditorSettings.TrimTextOnFallbackCopy}"
                                         CopyAltFallbackAction="{Binding EditorSettings.CopyAltFallbackAction}"
                                         TrimTextOnAltFallbackCopy="{Binding EditorSettings.TrimTextOnAltFallbackCopy}"
                                         AutoCopy="{Binding EditorSettings.CopyOnSelect}"
                                         PasteAction="{Binding EditorSettings.PasteAction}"
                                         TrimTextOnPaste="{Binding EditorSettings.TrimTextOnPaste}"
                                         PasteAltAction="{Binding EditorSettings.PasteAltAction}"
                                         TrimTextOnAltPaste="{Binding EditorSettings.TrimTextOnAltPaste}"
                                         MiddleClickPaste="{Binding EditorSettings.MiddleClickPaste}"
                />
        </Grid>
    </Grid>
</Window>
