<Window x:Class="TimmyTools.WpfUi.Views.ClipboardWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:TimmyTools.WpfUi.ViewModels"
        Title="Clipboard"
        Width="380" Height="560"
        MinWidth="280" MinHeight="320"
        ResizeMode="CanResize"
        WindowStartupLocation="CenterScreen"
        Background="#333333"
        Topmost="{Binding ClipboardSettings.AlwaysOnTop, Mode=OneWay}"
        d:DataContext="{d:DesignInstance Type=vm:ClipboardViewModel}"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d">

    <Window.Icon>
        <!-- Vector clipboard mark: matches the note title-bar launcher glyph.
             A rounded green tile with a white-stroked board + clip tab + two
             content lines, readable against both light and dark taskbars. -->
        <DrawingImage>
            <DrawingImage.Drawing>
                <DrawingGroup>
                    <!-- Rounded accent tile -->
                    <GeometryDrawing Brush="#2E7D32">
                        <GeometryDrawing.Geometry>
                            <RectangleGeometry Rect="0,0,32,32" RadiusX="7" RadiusY="7"/>
                        </GeometryDrawing.Geometry>
                    </GeometryDrawing>
                    <!-- Board body -->
                    <GeometryDrawing Geometry="M 8,8 H 24 V 27 H 8 Z">
                        <GeometryDrawing.Pen>
                            <Pen Brush="White" Thickness="2.4" LineJoin="Round"/>
                        </GeometryDrawing.Pen>
                    </GeometryDrawing>
                    <!-- Clip tab -->
                    <GeometryDrawing Geometry="M 13,8 V 5.5 H 19 V 8">
                        <GeometryDrawing.Pen>
                            <Pen Brush="White" Thickness="2.4" StartLineCap="Round" EndLineCap="Round" LineJoin="Round"/>
                        </GeometryDrawing.Pen>
                    </GeometryDrawing>
                    <!-- Two content lines -->
                    <GeometryDrawing Geometry="M 12,15 H 20 M 12,20 H 20">
                        <GeometryDrawing.Pen>
                            <Pen Brush="White" Thickness="2" StartLineCap="Round" EndLineCap="Round"/>
                        </GeometryDrawing.Pen>
                    </GeometryDrawing>
                </DrawingGroup>
            </DrawingImage.Drawing>
        </DrawingImage>
    </Window.Icon>

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>

        <!-- In-panel capture pulse: the readout background flashes to a brighter
             green and eases back over ~0.6s. This is the on-copy confirmation,
             contained entirely within the window (no floating toast). -->
        <Storyboard x:Key="CapturePulse">
            <ColorAnimation Storyboard.TargetName="CurrentClipPanelBrush"
                            Storyboard.TargetProperty="Color"
                            From="#2E7D32" To="#1F3A24"
                            Duration="0:0:0.6"/>
        </Storyboard>

        <!-- Small transparent icon button (pin / delete), Segoe MDL2 glyphs -->
        <Style x:Key="RowIconButtonStyle" TargetType="Button">
            <Setter Property="Foreground" Value="#999999"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontFamily" Value="Segoe MDL2 Assets"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="Padding" Value="6,2"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Footer text button -->
        <Style x:Key="FooterButtonStyle" TargetType="Button">
            <Setter Property="Foreground" Value="#DDDDDD"/>
            <Setter Property="Background" Value="#444444"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="Margin" Value="4,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="4"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#555555"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <DockPanel LastChildFill="True" Margin="10">

        <!-- Search box -->
        <Grid DockPanel.Dock="Top" Margin="0,0,0,8">
            <TextBox Text="{Binding Filter, UpdateSourceTrigger=PropertyChanged}"
                     Background="#1E1E1E"
                     Foreground="White"
                     BorderBrush="#555555"
                     CaretBrush="White"
                     Padding="8,6"
                     FontSize="14"
                     VerticalContentAlignment="Center"
                     ToolTip="Filter clipboard history"/>
            <TextBlock Text="Search clipboard history"
                       Foreground="#777777"
                       IsHitTestVisible="False"
                       Margin="10,0,0,0"
                       VerticalAlignment="Center"
                       FontSize="14">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Filter}" Value="">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
        </Grid>

        <!-- Always-visible current-clip panel: the clipbrd.exe-style live readout.
             Never collapses; shows an empty state when nothing is on the clipboard.
             Updates the instant a copy is captured, so a glance confirms the copy.
             On capture the background briefly flashes brighter (the in-panel pulse)
             so confirmation stays inside this window and never floats onto a shared
             screen. The Background is a named brush so the pulse storyboard can
             animate its colour. -->
        <Border x:Name="CurrentClipPanel"
                DockPanel.Dock="Top"
                BorderBrush="#4FA968"
                BorderThickness="2"
                CornerRadius="6"
                Padding="14,12"
                Margin="0,0,0,10">
            <Border.Background>
                <SolidColorBrush x:Name="CurrentClipPanelBrush" Color="#1F3A24"/>
            </Border.Background>
            <StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                    <!-- Clipboard glyph + bold label, never colour alone -->
                    <TextBlock Text="&#xE16F;"
                               FontFamily="Segoe MDL2 Assets"
                               Foreground="#9FD8AC"
                               FontSize="16"
                               VerticalAlignment="Center"
                               Margin="0,0,8,0"/>
                    <TextBlock Text="ON CLIPBOARD NOW"
                               Foreground="#9FD8AC"
                               FontSize="13"
                               FontWeight="Bold"
                               VerticalAlignment="Center"/>
                </StackPanel>

                <!-- The live clip text, large and readable -->
                <TextBlock Text="{Binding CurrentClipPreview}"
                           Foreground="White"
                           FontSize="16"
                           FontWeight="SemiBold"
                           TextTrimming="CharacterEllipsis"
                           MaxHeight="56"
                           TextWrapping="Wrap"
                           Visibility="{Binding HasCurrentClip, Converter={StaticResource BoolToVis}}"/>

                <!-- Empty state -->
                <TextBlock Text="Clipboard is empty — copy something to see it here."
                           Foreground="#7FB58D"
                           FontSize="14"
                           FontStyle="Italic"
                           TextWrapping="Wrap">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HasCurrentClip}" Value="False">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </StackPanel>
        </Border>

        <!-- Footer: always-on-top toggle + clear all -->
        <Grid DockPanel.Dock="Bottom" Margin="0,8,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- Always on top: an explicit user toggle, never tied to focus -->
            <CheckBox Grid.Column="0"
                      Content="Keep on top"
                      Foreground="#DDDDDD"
                      VerticalAlignment="Center"
                      IsChecked="{Binding ClipboardSettings.AlwaysOnTop, Mode=TwoWay}"
                      ToolTip="Pin this window above other windows (explicit, not focus-driven)"/>

            <Button Grid.Column="1"
                    Style="{StaticResource FooterButtonStyle}"
                    Command="{Binding ClearHistoryCommand}"
                    ToolTip="Delete all unpinned entries">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE74D;"
                               FontFamily="Segoe MDL2 Assets"
                               FontSize="13"
                               VerticalAlignment="Center"
                               Margin="0,0,6,0"/>
                    <TextBlock Text="Clear all" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>
        </Grid>

        <!-- Empty-state hint -->
        <TextBlock DockPanel.Dock="Bottom"
                   Text="No clipboard history yet. Copy something to get started."
                   Foreground="#888888"
                   FontSize="13"
                   TextWrapping="Wrap"
                   TextAlignment="Center"
                   Margin="0,20,0,0"
                   Visibility="{Binding IsHistoryEmpty, Converter={StaticResource BoolToVis}}"/>

        <!-- History list -->
        <ListBox ItemsSource="{Binding HistoryView}"
                 Background="Transparent"
                 BorderThickness="0"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                 HorizontalContentAlignment="Stretch">
            <ListBox.ItemContainerStyle>
                <Style TargetType="ListBoxItem">
                    <Setter Property="Background" Value="Transparent"/>
                    <Setter Property="Padding" Value="0"/>
                    <Setter Property="Margin" Value="0,0,0,6"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="ListBoxItem">
                                <Border Background="{TemplateBinding Background}"
                                        CornerRadius="4">
                                    <ContentPresenter/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="#3A3A3A"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </ListBox.ItemContainerStyle>
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Border Background="#2A2A2A"
                            CornerRadius="4"
                            Padding="8,6">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <!-- Content-type icon (text glyph today) + pinned marker -->
                            <StackPanel Grid.Column="0" VerticalAlignment="Top" Margin="0,2,8,0">
                                <TextBlock Text="&#xE8C8;"
                                           FontFamily="Segoe MDL2 Assets"
                                           Foreground="#888888"
                                           FontSize="14"
                                           ToolTip="Text"/>
                                <!-- Pin marker: glyph, shown only when pinned (shape cue, not colour) -->
                                <TextBlock Text="&#xE718;"
                                           FontFamily="Segoe MDL2 Assets"
                                           Foreground="#E0B341"
                                           FontSize="12"
                                           Margin="0,4,0,0"
                                           ToolTip="Pinned"
                                           HorizontalAlignment="Center"
                                           Visibility="{Binding Pinned, Converter={StaticResource BoolToVis}}"/>
                            </StackPanel>

                            <!-- Preview + timestamp. Click anywhere restores. -->
                            <Button Grid.Column="1"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    Cursor="Hand"
                                    HorizontalContentAlignment="Stretch"
                                    Command="{Binding DataContext.RestoreEntryCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                    CommandParameter="{Binding}"
                                    ToolTip="Click to put this back on the clipboard">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <ContentPresenter/>
                                    </ControlTemplate>
                                </Button.Template>
                                <StackPanel>
                                    <TextBlock Text="{Binding Preview}"
                                               Foreground="White"
                                               FontSize="13"
                                               TextTrimming="CharacterEllipsis"
                                               TextWrapping="Wrap"
                                               MaxHeight="40"/>
                                    <TextBlock Text="{Binding TimeDisplay}"
                                               Foreground="#888888"
                                               FontSize="11"
                                               Margin="0,2,0,0"/>
                                </StackPanel>
                            </Button>

                            <!-- Pin toggle -->
                            <Button Grid.Column="2"
                                    Style="{StaticResource RowIconButtonStyle}"
                                    Content="&#xE718;"
                                    Command="{Binding DataContext.PinEntryCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                    CommandParameter="{Binding}"
                                    ToolTip="Pin / unpin"/>

                            <!-- Delete -->
                            <Button Grid.Column="3"
                                    Style="{StaticResource RowIconButtonStyle}"
                                    Content="&#xE711;"
                                    Command="{Binding DataContext.DeleteEntryCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                    CommandParameter="{Binding}"
                                    ToolTip="Delete this entry"/>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

    </DockPanel>
</Window>
