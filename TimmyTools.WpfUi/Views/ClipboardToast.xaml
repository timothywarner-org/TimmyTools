<Window x:Class="TimmyTools.WpfUi.Views.ClipboardToast"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowActivated="False"
        ShowInTaskbar="False"
        Topmost="True"
        ResizeMode="NoResize"
        SizeToContent="WidthAndHeight"
        IsHitTestVisible="False">

    <Border Background="#222222"
            BorderBrush="#3C7A4A"
            BorderThickness="1"
            CornerRadius="6"
            Padding="14,10"
            MaxWidth="360">
        <StackPanel>
            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                <!-- Check glyph + text label, never colour alone -->
                <TextBlock Text="&#xE73E;"
                           FontFamily="Segoe MDL2 Assets"
                           Foreground="#9FD8AC"
                           FontSize="13"
                           VerticalAlignment="Center"
                           Margin="0,0,6,0"/>
                <TextBlock Text="Copied to clipboard"
                           Foreground="#9FD8AC"
                           FontSize="12"
                           FontWeight="SemiBold"
                           VerticalAlignment="Center"/>
            </StackPanel>
            <TextBlock x:Name="PreviewText"
                       Foreground="White"
                       FontSize="13"
                       TextTrimming="CharacterEllipsis"
                       MaxHeight="40"
                       TextWrapping="Wrap"/>
        </StackPanel>
    </Border>
</Window>
